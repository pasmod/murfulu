# Copy to .env and adjust. The real .env is never committed.

# Postgres — authored data: rules, expert feedback, generation cache.
POSTGRES_USER=murfulu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=murfulu
POSTGRES_PORT=5432

# Elasticsearch — corpus documents, word types, derivations.
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# API
API_PORT=8000

# The React app, served by nginx and proxying /api to the API container.
WEB_PORT=5173

# The karbon lexicon snapshot, as seen inside the container. ./data is mounted
# read-only at /data. Never hardcode this path in code — see PLAN task 3.1.
MURFULU_LEXICON_PATH=/data/lexicon-20261012.sqlite

# Per-rule productivity, written by tools/run_productivity.py into ./data.
# Nothing breaks if it is missing; the rules screen says it has not been run.
MURFULU_PRODUCTIVITY_PATH=/data/rule_productivity-v14.json

# What the ingest measured about the corpus: sizes, coverage, the unmatched
# pile. Written by tools/run_ingest.py --report-out into ./data. Absent until
# an ingest has been run, and the corpus screen says so.
MURFULU_CORPUS_REPORT_PATH=/data/corpus_report-v14.json
# The semantic artefact: base vectors and per-rule centroids, written by
# tools/build_semantic_vectors.py into ./data. Absent until it has been run,
# and every form's semantic part is then null — not measured, never low.
MURFULU_SEMANTIC_PATH=/data/semantic-v4.json

# Where the semantic scores sit relative to each other, written by
# tools/measure_typicality_spread.py into ./data. The score is a cosine and
# never leaves the middle — every one of 583,572 falls between 55% and 91%,
# the middle half between 80% and 85% — so a bare figure reads as a mark out
# of a hundred when 84% is the median. Absent is legitimate: the figure is
# then shown with no position rather than a guessed one.
MURFULU_TYPICALITY_PATH=/data/typicality-v14.json

# The Ganjoor dump the corpus is ingested from. **A host path, and only the
# batch tools read it** — tools/run_ingest.py and tools/run_precompute.py.
# The API never opens it, so it is deliberately not passed to any container.
#
# It was missing from this file until 2026-08-13, and the cost was that a
# rebuild could not be reproduced from the repository: run_precompute.py
# stopped with "MURFULU_GANJOOR_PATH is not set" and the dump had to be
# hunted for on disk. The corpus report records what it was built from —
# 133,148 documents, 25,497,189 words — so a candidate can be checked against
# it before a rebuild is trusted.
MURFULU_GANJOOR_PATH=/absolute/path/to/ganjoor.db

# Which century each poet wrote in — 43 of them. Also a host path, also read
# only by the batch tools.
#
# **Not setting it does not fail.** run_ingest.py prints "centuries none
# loaded" and carries on, and the corpus builds with every poem undated:
# every word gets a null first_century and last_century and an empty
# counts_by_century, so the century chart on the word screen is blank and
# nothing else looks wrong. It was missing from this file until 2026-08-13
# and v6 was built without it — 133,148 documents undated against v4's
# 98,627, which is the number to check a rebuild against.
#
# The report records it, so `documents_without_century` in
# data/corpus_report-*.json is how a finished version is checked before it is
# released.
MURFULU_GANJOOR_CENTURIES=/absolute/path/to/poet_centuries.json

# ─── Server only. Nothing below is read on a laptop. ─────────────────────────
# See docs/DEPLOY.md. Used by docker-compose.prod.yml and the Caddyfile.

# The subdomain Caddy answers on, and asks Let's Encrypt for a certificate
# for. It must already point at this server's public IP, or the first start
# fails at the certificate and Caddy retries into a rate limit.
MURFULU_DOMAIN=murfulu.mosaic-hub.de

# The site address **with its scheme**, because the scheme is what decides
# whether Caddy asks Let's Encrypt for a certificate.
#
#   murfulu.mosaic-hub.de          on a server — automatic HTTPS
#   http://murfulu.mosaic-hub.de   behind a Cloudflare Tunnel, which already
#                                  terminates TLS and forwards plain HTTP
#
# Defaults to MURFULU_DOMAIN, which is the server case.
MURFULU_SITE_ADDRESS=http://murfulu.mosaic-hub.de

# Which address Caddy publishes on. **127.0.0.1 unless this machine really is
# the public address.** The sibling apps on this domain are published from a
# workstation through a tunnel; a container on 0.0.0.0:80 there offers the
# corpus to everything on the same wifi as well as to cloudflared. On a server
# with a public IP, set 0.0.0.0.
MURFULU_BIND=127.0.0.1

# The wall in front of everything, and **the only credential there is** as of
# 2026-08-17. It used to sit in front of a second one: the app had accounts,
# API tokens and an expert role, and a reader needed both to be useful. There
# is one account and no roles now, so whoever knows this password may look at
# the corpus and also rule on a question. Set it accordingly.
MURFULU_SITE_USER=murfulu

# A bcrypt hash, never the password itself. Generate it with:
#   docker run --rm caddy:2.9.1-alpine caddy hash-password --plaintext 'the-password'
MURFULU_SITE_PASSWORD_HASH=$2a$14$replace-me

# Where the lexicon and the measured artefacts live on the server. Mounted
# read-only at /data, the same as ./data is on a laptop, so every
# MURFULU_*_PATH above stays as it is.
MURFULU_DATA_DIR=/srv/murfulu/data
