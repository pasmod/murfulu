# Which machine serves production, for deploy/server.sh. Copy to
# deploy/host.env (gitignored) and fill in. The machine's address, user and
# port are in deploy/ssh_config, from deploy/ssh_config.example; the tunnel is
# in deploy/cloudflared/config.yml. None of the three is ever committed
# (docs/DEPLOY.md §0).

# The Host entry in deploy/ssh_config that reaches the production host.
MURFULU_SSH_HOST=murfulu-prod

# The checkout on that host, relative to the SSH user's home: code, data and
# the server .env live here.
MURFULU_REMOTE_DIR=murfulu

# The fallback: the machine that served before, its stack kept running with
# its connector stopped. counts, corpus, db, db-back, cutover and rollback work
# against it; leave both unset and the fallback is the Mac's own stack.
MURFULU_FALLBACK_SSH_HOST=murfulu-fallback
MURFULU_FALLBACK_REMOTE_DIR=murfulu
