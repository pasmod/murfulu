# The server's .env (~/murfulu/.env on the production host — the directory is
# MURFULU_REMOTE_DIR in deploy/host.env). `deploy/server.sh env`
# writes it from this file once and fills the empty secrets server-side:
#   POSTGRES_PASSWORD           generated there (openssl rand), never on the Mac
#   MURFULU_SITE_USER           copied from the Mac's .env, so the
#   MURFULU_SITE_PASSWORD_HASH  existing site password keeps working
# Never commit the filled-in file.
POSTGRES_USER=murfulu
POSTGRES_PASSWORD=
POSTGRES_DB=murfulu

# 1 GB heap inside the 3 GB mem_limit of docker-compose.server.yml, so ~1.5 GB
# stay for Lucene's page cache (passages is 2 GB). Measured 2026-10-27: after
# 9.6 days serving v14 the heap was 28% used with no old-generation GC; a 2 GB
# heap left 2.5 GiB anonymous memory and ~0.5 GB of cache inside the limit.
ES_JAVA_OPTS=-Xms1g -Xmx1g

# The lexicon and the measured artefacts, rsynced by `deploy/server.sh data`
# into ~/murfulu/data and mounted read-only at /data.
MURFULU_DATA_DIR=./data
MURFULU_LEXICON_PATH=/data/lexicon-20261012.sqlite
MURFULU_PRODUCTIVITY_PATH=/data/rule_productivity-v14.json
MURFULU_CORPUS_REPORT_PATH=/data/corpus_report-v14.json
MURFULU_SEMANTIC_PATH=/data/semantic-v4.json
MURFULU_TYPICALITY_PATH=/data/typicality-v14.json

# Behind the tunnel: Cloudflare holds the certificate, Caddy serves plain HTTP.
MURFULU_DOMAIN=murfulu.mosaic-hub.de
MURFULU_SITE_ADDRESS=http://murfulu.mosaic-hub.de
MURFULU_BIND=127.0.0.1
MURFULU_SITE_USER=
MURFULU_SITE_PASSWORD_HASH=
